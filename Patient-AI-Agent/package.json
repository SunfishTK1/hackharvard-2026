{
  "name": "patient-ai-agent",
  "version": "0.1.0",
  "private": true,
  "description": "iMessage patient assistant for clinical trials: prequalification, e-consent, scheduling and check-ins with in-chat mini-apps",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "chat": "node src/scripts/chat.ts",
    "migrate": "node src/scripts/migrate.ts",
    "seed": "node src/scripts/seed.ts",
    "enroll": "node src/scripts/enroll.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/domain.test.ts",
    "test:db": "node --test test/bridge.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@resvg/resvg-js": "^2.6.2",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@typesafe-ai/sdk": "0.6.0",
    "jpeg-js": "^0.4.4",
    "pg": "^8.23.1",
    "spectrum-ts": "^12.11.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  }
}
