// Sage build settings.
//
// To run on an iPhone, set your Apple Developer Team ID. Put it in Config/Local.xcconfig
// (gitignored) so it stays out of the repo:
//
//   SAGE_TEAM_ID = ABCDE12345
//
// The same Team ID goes in the server's IMESSAGE_TEAM_ID so Sage's cards open this app.

SAGE_TEAM_ID =
SAGE_BUNDLE_ID = com.velroi.sage
// The mini-app server. The $() keeps xcconfig from reading // as a comment.
SAGE_BASE_URL = https:/$()/patient.hackharvard2026.velroi.com

#include? "Local.xcconfig"
