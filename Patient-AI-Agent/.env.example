# Locally these are also read from the repo-root .env and Clinical-DB/.env under the names they
# already have there; set them here only to override.

# Postgres as the patient_assistant role (row-level security scopes it to one person at a time).
PATIENT_ASSISTANT_DATABASE_URL=postgresql://patient_assistant:PASSWORD@db.hackharvard2026.velroi.com:5432/clinical_trials?sslmode=require
# Migrations, the demo seed and the staff enroll script: a role that can act as app_owner (developer).
STAFF_DATABASE_URL=postgresql://developer:PASSWORD@db.hackharvard2026.velroi.com:5432/clinical_trials?sslmode=require
# Port 5432 is firewalled; through an SSH tunnel (ssh -N -L 15432:localhost:5432 root@server):
# DATABASE_HOST=localhost:15432
# Point everything at another database on the same server, e.g. the demo copy:
# DATABASE_NAME=assistant_demo

ANTHROPIC_API_KEY=
# TypeSafe (Jev) decides which bot answers each message on the shared iMessage line.
TYPESAFE_API_KEY=
# ROUTER=ai | pattern | off   (default: ai with a TypeSafe key, else pattern with ENGAGE_PATTERN, else off)
# ENGAGE_PATTERN=\b(study|trial|migraine)\b

# Spectrum (Photon 1.0) project whose iMessage line the assistant answers on. Optional for `npm run chat`.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Where the mini-apps are served; its host is also the Face ID (passkey) relying party.
PUBLIC_URL=http://localhost:3010
# DEFAULT_STUDY=NORTHSTAR-DEMO   (default: the most recently updated active study)
# ASSISTANT_NAME=Sage
# AGENT_MODEL=claude-haiku-5-5
# AGENT_EFFORT=low

# xAI: Grok voice for "Answer by voice" (realtime), and speech-to-text / text-to-speech for voice messages in the chat.
XAI_API_KEY=
# SAGE_VOICE=eve
