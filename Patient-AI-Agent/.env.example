# Locally these are also read from the repo-root .env and Clinical-DB/.env under the names they
# already have there; set them here only to override.

# Postgres as the patient_assistant role (row-level security scopes it to one person at a time).
PATIENT_ASSISTANT_DATABASE_URL=postgresql://patient_assistant:PASSWORD@db.hackharvard2026.velroi.com:5432/clinical_trials?sslmode=require
# Migrations, the demo seed and the staff enroll script: a role that can act as app_owner (developer).
STAFF_DATABASE_URL=postgresql://developer:PASSWORD@db.hackharvard2026.velroi.com:5432/clinical_trials?sslmode=require
# Port 5432 is firewalled; through an SSH tunnel (ssh -N -L 15432:localhost:5432 root@server):
# DATABASE_HOST=localhost:15432
# Point everything at another database on the same server, e.g. the demo copy:
# DATABASE_NAME=assistant_demo

ANTHROPIC_API_KEY=
# TypeSafe (Jev) decides which bot answers each message on the shared iMessage line.
TYPESAFE_API_KEY=
# ROUTER=ai | pattern | off   (default: ai with a TypeSafe key, else pattern with ENGAGE_PATTERN, else off)
# ENGAGE_PATTERN=\b(study|trial|migraine)\b

# Spectrum (Photon 1.0) project whose iMessage line the assistant answers on. Optional for `npm run chat`.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Where the mini-apps are served; its host is also the Face ID (passkey) relying party.
PUBLIC_URL=http://localhost:3010
# DEFAULT_STUDY=NORTHSTAR-DEMO   (default: the most recently updated active study)
# ASSISTANT_NAME=Sage
# AGENT_MODEL=claude-haiku-5-5
# AGENT_EFFORT=low

# xAI: Grok voice for "Answer by voice" (realtime), and speech-to-text / text-to-speech for voice messages in the chat.
XAI_API_KEY=
# SAGE_VOICE=eve

# Trial Ops, the agent for trial managers (src/ops). Off without its database login.
# The platform's manager_agent role (it reads only the ops.* views). Locally MANAGER_AGENT_DATABASE_URL works too.
TRIAL_OPS_DATABASE_URL=postgresql://manager_agent:PASSWORD@db.hackharvard2026.velroi.com:5432/clinical_trials?sslmode=require
# Its own Photon project and iMessage line (photon projects create; photon spectrum users add).
# Without them, linked managers reach Trial Ops on Sage's line by texting "ops".
TRIAL_OPS_SPECTRUM_PROJECT_ID=
TRIAL_OPS_SPECTRUM_PROJECT_SECRET=
# The internal API other apps use (the ops website's Agentic mode). Off without a token; never proxied.
TRIAL_OPS_API_TOKEN=
# TRIAL_OPS_API_PORT=3012
# TRIAL_OPS_WEB_ORIGINS=https://ops.hackharvard2026.velroi.com,http://localhost:3000,http://localhost:5173
# Demo only: sign in to the ops website with a linked number + full name (the manager is texted each time).
# TRIAL_OPS_WEB_SELF_VOUCH=1
# OPS_MODEL=claude-opus-5-5
# OPS_EFFORT=low
# OPS_ANALYST_MODEL=claude-opus-5-5
# OPS_ANALYST_EFFORT=medium

# Daytona cloud computers for Trial Ops analyses. Off without a key.
DAYTONA_API_KEY=
# OPS_COMPUTER_CPU=2
# OPS_COMPUTER_MEMORY=4
# OPS_COMPUTER_DISK=10
# OPS_COMPUTER_IMAGE=python:3.12
# OPS_COMPUTER_SNAPSHOT=

# Email (Resend): the site investigator hears when someone signs the informed consent. Off without a key.
RESEND_API_KEY=
# A sender on a domain verified in Resend; the default (onboarding@resend.dev) only reaches the Resend account owner.
# EMAIL_FROM=Sage <sage@your-verified-domain>
# Send investigator emails to one address instead of the investigators' on file:
# PI_EMAIL=bl108@wellesley.edu

# Demo reset code: a team phone (an active Trial Ops manager) that texts this to Sage starts over as
# someone new. Archives the old journey, never deletes. Keep the real value only in the server's .env.
# SAGE_RESET_CODE=
