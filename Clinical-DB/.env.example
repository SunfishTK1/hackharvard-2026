# Server: /opt/apps/clinical-db/.env (chmod 600). Never commit real values.
# Use long random letters and digits so the values are safe inside connection URLs.
POSTGRES_PASSWORD=change-me            # superuser; socket-only, never used over the network
DEVELOPER_PASSWORD=change-me           # teammates: full read/write and migrations
PATIENT_AGENT_PASSWORD=change-me       # patient iMessage agent (row-level scoped to one patient)
MANAGER_AGENT_PASSWORD=change-me       # trial manager iMessage agent (analytics views + own memory)
ANALYST_PASSWORD=change-me             # read-only: notebooks, dashboards, the web browser
PGWEB_USER=team                        # basic auth for https://db.74-208-206-131.sslip.io
PGWEB_PASSWORD=change-me

# Your laptop: Clinical-DB/.env. dbmate reads DATABASE_URL from here.
# DATABASE_URL=postgres://developer:<password>@74.208.206.131:5432/clinical_trials?sslmode=require
# PATIENT_AGENT_DATABASE_URL=postgres://patient_agent:<password>@74.208.206.131:5432/clinical_trials?sslmode=require
# MANAGER_AGENT_DATABASE_URL=postgres://manager_agent:<password>@74.208.206.131:5432/clinical_trials?sslmode=require
# ANALYST_DATABASE_URL=postgres://analyst:<password>@74.208.206.131:5432/clinical_trials?sslmode=require
# DBMATE_NO_DUMP_SCHEMA=true
