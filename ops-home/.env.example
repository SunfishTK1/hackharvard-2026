# /opt/apps/ops-home/.env on the server (chmod 600), or ops-home/.env locally. Never commit real values.
# Server: reach Postgres over the shared Docker network.
DATABASE_URL=postgres://developer:<password>@clinical-db-postgres-1:5432/clinical_trials
# Local development: use the public TLS endpoint instead.
# DATABASE_URL=postgres://developer:<password>@db.hackharvard2026.velroi.com:5432/clinical_trials?sslmode=require
# DISPLAY_TZ=America/New_York
# Agentic mode: the Trial Ops API (Patient-AI-Agent's internal port on the `web` network) and the
# shared token it expects. Without the token, Agentic mode shows "isn't connected yet".
TRIAL_OPS_API_URL=http://patient-assistant:3012
TRIAL_OPS_API_TOKEN=
# Where texted sign-in links land (set in compose for the server).
# PUBLIC_URL=https://ops.hackharvard2026.velroi.com
